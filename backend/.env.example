# Recorded World - Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Recorded World
APP_VERSION=0.4.0
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (development)
DATABASE_URL=sqlite:///./recorded_world.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/recorded_world
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=recorded_world
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here

# =============================================================================
# Upload & File Storage
# =============================================================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes
MAX_FILE_SIZE_MB=500
ALLOWED_UPLOAD_EXTENSIONS=.mp4,.mov,.avi,.webm,.jpg,.jpeg,.png

# =============================================================================
# WebSocket Server
# =============================================================================
WS_HOST=0.0.0.0
WS_PORT=8765

# =============================================================================
# Security & Authentication
# =============================================================================
# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate a new key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_random_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# API Key Settings
API_KEY_PREFIX=rw_
API_KEY_LENGTH=32

# Signed URL Expiry (seconds)
SIGNED_URL_EXPIRY_SECONDS=3600

# =============================================================================
# Rate Limiting (requests per window)
# =============================================================================
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_WS_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
